<?xml version="1.0"?>
<!--
  Visualization only: the real localization stack already owns map -> odom ->
  base_link.  This single-link URDF deliberately contains no joint, collision,
  inertial, sensor frame, Gazebo plugin or TF publisher.

  The source simulation mesh is re-centered onto the real base_link convention
  (vehicle rotation center projected onto the ground, x forward, y left, z up)
  and scaled in plan to the measured 2.00 m x 1.20 m footprint.
-->
<robot name="desert_tracker_visual">
  <material name="vehicle_silver">
    <color rgba="0.675 0.710 0.737 1.0"/>
  </material>
  <link name="base_link">
    <visual name="vehicle_body_visual">
      <origin xyz="-0.125882 0.005008 0.490000"
              rpy="1.57079632679 0 1.57079632679"/>
      <geometry>
        <mesh filename="package://vehicle_description/meshes/base_link_visual.stl"
              scale="0.000705882353 0.001 0.000919614633"/>
      </geometry>
      <material name="vehicle_silver"/>
    </visual>
  </link>
</robot>
