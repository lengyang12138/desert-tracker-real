<?xml version="1.0"?>
<package format="2">
  <name>navigation</name>
  <version>0.1.0</version>
  <description>Terrain-aware Hybrid A* and tracked-vehicle MPC.</description>
  <maintainer email="maintainer@example.com">desert-tracker maintainers</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>costmap_2d</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_core</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>move_base</exec_depend>

  <export>
    <nav_core plugin="${prefix}/my_global_planner_plugin.xml"/>
    <nav_core plugin="${prefix}/mpc_local_planner_plugin.xml"/>
  </export>
</package>
