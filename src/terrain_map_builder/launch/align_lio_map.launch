<launch>
  <!--
    Re-express a saved LIO-SAM PCD in the navigation O-XYZ/map frame.
    If reference_pose_file is non-empty, the first LIO-SAM key pose and the
    LiDAR extrinsic are used. Otherwise the explicit rigid transform is used.
    The source file is never overwritten.
  -->
  <arg name="project_root" default="$(find terrain_map_builder)/../.."/>
  <arg name="map_module" default="site_a"/>
  <arg name="map_module_dir"
       default="$(eval arg('map_module') if len(arg('map_module')) > 0 and arg('map_module')[0].isalnum() and arg('map_module').replace('_','').replace('-','').isalnum() else 'INVALID_MAP_MODULE')"/>
  <arg name="input_pcd" default="$(arg project_root)/maps/$(arg map_module_dir)/raw/GlobalMap.pcd"/>
  <arg name="output_pcd" default="$(arg project_root)/maps/$(arg map_module_dir)/aligned/GlobalMap.pcd"/>
  <arg name="reference_pose_file" default=""/>
  <arg name="transform_info_output" default="$(arg output_pcd).alignment.yaml"/>
  <arg name="translation_x" default="0"/>
  <arg name="translation_y" default="0"/>
  <arg name="translation_z" default="0"/>
  <arg name="roll_deg" default="0"/>
  <arg name="pitch_deg" default="0"/>
  <arg name="yaw_deg" default="0"/>
  <arg name="sensor_x" default="0"/>
  <arg name="sensor_y" default="0"/>
  <arg name="sensor_z" default="0"/>
  <arg name="sensor_roll_deg" default="0"/>
  <arg name="sensor_pitch_deg" default="0"/>
  <arg name="sensor_yaw_deg" default="0"/>

  <node pkg="terrain_map_builder" type="pcd_frame_transform"
        name="align_lio_map" output="screen">
    <param name="input" value="$(arg input_pcd)"/>
    <param name="output" value="$(arg output_pcd)"/>
    <param name="reference_pose_file" value="$(arg reference_pose_file)"/>
    <param name="transform_info_output" value="$(arg transform_info_output)"/>
    <param name="translation_x" value="$(arg translation_x)"/>
    <param name="translation_y" value="$(arg translation_y)"/>
    <param name="translation_z" value="$(arg translation_z)"/>
    <param name="roll_deg" value="$(arg roll_deg)"/>
    <param name="pitch_deg" value="$(arg pitch_deg)"/>
    <param name="yaw_deg" value="$(arg yaw_deg)"/>
    <param name="sensor_x" value="$(arg sensor_x)"/>
    <param name="sensor_y" value="$(arg sensor_y)"/>
    <param name="sensor_z" value="$(arg sensor_z)"/>
    <param name="sensor_roll_deg" value="$(arg sensor_roll_deg)"/>
    <param name="sensor_pitch_deg" value="$(arg sensor_pitch_deg)"/>
    <param name="sensor_yaw_deg" value="$(arg sensor_yaw_deg)"/>
  </node>
</launch>
