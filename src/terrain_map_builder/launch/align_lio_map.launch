<launch>
  <!--
    Re-express a saved LIO-SAM PCD in the navigation O-XYZ/map frame.
    The rigid transform is loaded from the alignment result YAML generated by
    align_qianxun_lio.py.  Do not repeat transform numbers on the command line.
    The source file is never overwritten.
  -->
  <arg name="project_root" default="$(find terrain_map_builder)/../.."/>
  <arg name="map_module" default="site_a"/>
  <arg name="map_module_dir"
       default="$(eval arg('map_module') if len(arg('map_module')) > 0 and arg('map_module')[0].isalnum() and arg('map_module').replace('_','').replace('-','').isalnum() else 'INVALID_MAP_MODULE')"/>
  <arg name="input_pcd" default="$(arg project_root)/maps/$(arg map_module_dir)/raw/GlobalMap.pcd"/>
  <arg name="output_pcd" default="$(arg project_root)/maps/$(arg map_module_dir)/aligned/GlobalMap.pcd"/>
  <arg name="reference_pose_file" default=""/>
  <arg name="transform_info_output" default="$(arg output_pcd).alignment.yaml"/>
  <arg name="alignment_config"
       default="$(arg project_root)/maps/$(arg map_module_dir)/aligned/qianxun_lio_alignment.yaml"/>

  <rosparam file="$(arg alignment_config)" command="load" ns="align_lio_map"/>

  <node pkg="terrain_map_builder" type="pcd_frame_transform"
        name="align_lio_map" output="screen">
    <param name="input" value="$(arg input_pcd)"/>
    <param name="output" value="$(arg output_pcd)"/>
    <param name="reference_pose_file" value="$(arg reference_pose_file)"/>
    <param name="transform_info_output" value="$(arg transform_info_output)"/>
  </node>
</launch>
